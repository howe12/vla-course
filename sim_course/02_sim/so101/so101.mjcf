<mujoco model="SO101">
  <visual>
    <headlight active="1" ambient="0.8 0.8 0.8" diffuse="0.6 0.6 0.6"/>
    <global offwidth="480" offheight="480"/>
  </visual>
  <compiler meshdir="meshes" angle="radian" autolimits="false"/>

  <default>
    <geom type="mesh" contype="0" conaffinity="0" rgba="1.0 0.82 0.12 1"/>
    <joint type="hinge" armature="0.001" damping="0.05" frictionloss="0.05"/>
  </default>

  <asset>
    <mesh name="base_motor_holder_so101_v1" file="base_motor_holder_so101_v1.obj"/>
    <mesh name="base_so101_v2" file="base_so101_v2.obj"/>
    <mesh name="sts3215_03a_v1" file="sts3215_03a_v1.obj"/>
    <mesh name="waveshare_mounting_plate_so101_v2" file="waveshare_mounting_plate_so101_v2.obj"/>
    <mesh name="motor_holder_so101_base_v1" file="motor_holder_so101_base_v1.obj"/>
    <mesh name="rotation_pitch_so101_v1" file="rotation_pitch_so101_v1.obj"/>
    <mesh name="upper_arm_so101_v1" file="upper_arm_so101_v1.obj"/>
    <mesh name="under_arm_so101_v1" file="under_arm_so101_v1.obj"/>
    <mesh name="motor_holder_so101_wrist_v1" file="motor_holder_so101_wrist_v1.obj"/>
    <mesh name="sts3215_03a_no_horn_v1" file="sts3215_03a_no_horn_v1.obj"/>
    <mesh name="wrist_roll_pitch_so101_v2" file="wrist_roll_pitch_so101_v2.obj"/>
    <mesh name="wrist_roll_follower_so101_v1" file="wrist_roll_follower_so101_v1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="moving_jaw_so101_v1" file="moving_jaw_so101_v1.obj"/>
  </asset>

  <worldbody>
    <light dir="0 0 -1" diffuse="0.9 0.9 0.9" ambient="0.45 0.45 0.45" pos="0.3 0.3 0.8"/>

    <!-- 白色仿真环境: 地板 + 四周白墙围成小房间(~1.6m), 默认镜头能同时看到臂 -->
    <geom name="bg_floor" type="plane" size="0.80 0.80 0.02" rgba="0.97 0.97 0.97 1" pos="0 0 -0.02" contype="0" conaffinity="0"/>
    <geom name="bg_wall_xp" type="box" size="0.04 0.82 0.75" rgba="0.97 0.97 0.97 1" pos="0.82 0 0.75" contype="0" conaffinity="0"/>
    <geom name="bg_wall_xn" type="box" size="0.04 0.82 0.75" rgba="0.97 0.97 0.97 1" pos="-0.82 0 0.75" contype="0" conaffinity="0"/>
    <geom name="bg_wall_yp" type="box" size="0.82 0.04 0.75" rgba="0.97 0.97 0.97 1" pos="0 0.82 0.75" contype="0" conaffinity="0"/>
    <geom name="bg_wall_yn" type="box" size="0.82 0.04 0.75" rgba="0.97 0.97 0.97 1" pos="0 -0.82 0.75" contype="0" conaffinity="0"/>
    <camera name="arm_cam" fovy="45" pos="0 0.45 0.28" mode="targetbody" target="jaw_link"/>

    <body name="base_link" pos="0 0 0">

    <geom name="g_base_link_base_motor_holder_so101_v1" mesh="base_motor_holder_so101_v1" pos="0.020692 0.022125 0.030082" quat="0.707108 0.000000 0.000000 0.707105" rgba="1.0 0.82 0.12 1"/>
    <geom name="g_base_link_base_so101_v2" mesh="base_so101_v2" pos="0.020791 0.022125 0.030082" quat="0.707108 0.000000 0.000000 0.707105" rgba="1.0 0.82 0.12 1"/>
    <geom name="g_base_link_sts3215_03a_v1" mesh="sts3215_03a_v1" pos="0.020791 -0.010575 0.076182" quat="-0.000000 0.000000 -0.707108 0.707105" rgba="0.15 0.15 0.15 1"/>
    <geom name="g_base_link_waveshare_mounting_plate_so101_v2" mesh="waveshare_mounting_plate_so101_v2" pos="0.020591 0.046744 0.079882" quat="0.707108 -0.000000 0.000000 0.707105" rgba="1.0 0.82 0.12 1"/>
        <body name="shoulder_link" pos="0.020791 -0.023075 0.094882" quat="-0.707105 -0.707108 0.000001 0.000001">
          <joint name="shoulder_pan" axis="0.000000 0.000000 1.000000" limited="true" range="-2.055000 2.058000"/>
        <geom name="g_shoulder_link_sts3215_03a_v1" mesh="sts3215_03a_v1" pos="-0.030399 0.000422 -0.041700" quat="0.500000 0.500000 -0.500002 0.499998" rgba="0.15 0.15 0.15 1"/>
        <geom name="g_shoulder_link_motor_holder_so101_base_v1" mesh="motor_holder_so101_base_v1" pos="-0.067599 -0.000178 0.015850" quat="0.500000 -0.500000 0.500002 0.499998" rgba="1.0 0.82 0.12 1"/>
        <geom name="g_shoulder_link_rotation_pitch_so101_v1" mesh="rotation_pitch_so101_v1" pos="0.012201 0.000022 0.046400" quat="-0.707108 0.000000 0.000000 0.707105" rgba="1.0 0.82 0.12 1"/>
            <body name="upper_arm_link" pos="-0.030399 -0.018278 -0.054200" quat="-0.500000 -0.500000 -0.500002 0.499998">
              <joint name="shoulder_lift" axis="0.000000 0.000000 1.000000" limited="true" range="-2.018000 2.018000"/>
            <geom name="g_upper_arm_link_sts3215_03a_v1" mesh="sts3215_03a_v1" pos="-0.112570 -0.015500 0.018700" quat="-0.707105 0.707108 -0.000001 0.000001" rgba="0.15 0.15 0.15 1"/>
            <geom name="g_upper_arm_link_upper_arm_so101_v1" mesh="upper_arm_so101_v1" pos="-0.065085 0.012000 0.018200" quat="1.000000 -0.000000 0.000000 0.000001" rgba="1.0 0.82 0.12 1"/>
                <body name="lower_arm_link" pos="-0.112570 -0.028000 0.000000" quat="-0.000000 -0.000000 0.707108 0.707105">
                  <joint name="elbow_flex" axis="0.000000 0.000000 1.000000" limited="true" range="-1.653000 1.654000"/>
                <geom name="g_lower_arm_link_under_arm_so101_v1" mesh="under_arm_so101_v1" pos="-0.064850 -0.032000 0.018200" quat="-1.000000 -0.000000 0.000000 0.000001" rgba="1.0 0.82 0.12 1"/>
                <geom name="g_lower_arm_link_motor_holder_so101_wrist_v1" mesh="motor_holder_so101_wrist_v1" pos="-0.064850 -0.032000 0.018000" quat="-1.000000 -0.000000 0.000000 0.000001" rgba="1.0 0.82 0.12 1"/>
                <geom name="g_lower_arm_link_sts3215_03a_v1" mesh="sts3215_03a_v1" pos="-0.122400 0.005200 0.018700" quat="-0.000001 1.000000 -0.000001 0.000000" rgba="0.15 0.15 0.15 1"/>
                    <body name="wrist_link" pos="-0.134900 0.005200 0.000000" quat="0.000000 -0.000000 -0.707108 0.707105">
                      <joint name="wrist_flex" axis="0.000000 0.000000 1.000000" limited="true" range="-1.786000 1.790000"/>
                    <geom name="g_wrist_link_sts3215_03a_no_horn_v1" mesh="sts3215_03a_no_horn_v1" pos="0.000000 -0.042400 0.030600" quat="0.500000 0.500000 -0.500002 0.499998" rgba="0.15 0.15 0.15 1"/>
                    <geom name="g_wrist_link_wrist_roll_pitch_so101_v2" mesh="wrist_roll_pitch_so101_v2" pos="0.000000 -0.028000 0.018100" quat="-0.500000 -0.500000 -0.500002 0.499998" rgba="1.0 0.82 0.12 1"/>
                        <body name="gripper_link" pos="0.000000 -0.061100 0.018100" quat="0.000001 0.707108 0.707105 0.000001">
                          <joint name="wrist_roll" axis="0.000000 0.000000 1.000000" limited="true" range="-3.194000 4.120000"/>
                        <geom name="g_gripper_link_sts3215_03a_v1" mesh="sts3215_03a_v1" pos="0.007700 0.000100 -0.023400" quat="-0.707108 0.000000 -0.000000 0.707105" rgba="0.15 0.15 0.15 1"/>
                        <geom name="g_gripper_link_wrist_roll_follower_so101_v1" mesh="wrist_roll_follower_so101_v1" pos="0.000000 -0.000218 0.000950" quat="-1.000000 -0.000000 -0.000000 0.000001" rgba="1.0 0.82 0.12 1"/>
                            <body name="jaw_link" pos="0.020200 0.018800 -0.023400" quat="0.707108 -0.000000 -0.000000 0.707105">
                              <joint name="gripper" axis="0.000000 0.000000 1.000000" limited="true" range="-0.174533 1.745330"/>
                            <geom name="g_jaw_link_moving_jaw_so101_v1" mesh="moving_jaw_so101_v1" pos="-0.000000 -0.000000 0.018900" quat="0.000000 -0.000000 0.000000 1.000000" rgba="1.0 0.82 0.12 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    
    </body>
  </worldbody>
</mujoco>
